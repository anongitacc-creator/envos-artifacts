# =============================================================================
# hub_xapp_commit_003 configuration - the single place every knob lives.
#
# Sourced by ./envctl, which exports all of it; every Python script reads the
# same variables from the environment with the same defaults. A value already
# in your environment always wins, and config.local.env (optional) overrides
# per machine.
# =============================================================================

# --- external substrate ------------------------------------------------------
: "${CUA_GYM_HUB:=$HOME/CUA-Gym-Hub}"

# --- kit-local toolchain -----------------------------------------------------
: "${ENVOS_OPT:=$ENVOS_KIT/.kit}"
: "${CHROME_BIN:=$(command -v google-chrome || command -v chromium || echo /usr/bin/google-chrome)}"

# --- episode identity --------------------------------------------------------
: "${ENVOS_SID:=hxc003}"
: "${ENVOS_ARM:=XAPP}"                 # CLEAN | XAPP | COLD | XAPP_ACL | REQCHG | POLICY | REQCHG_POLICY
                                       #   CLEAN  control, world stays consistent
                                       #   XAPP   breaks WHILE the agent watches
                                       #   COLD   already broken at step 0
                                       #   REQCHG the REQUEST is revised in
                                       #          place - nothing arrives

# --- the isolated desktop ----------------------------------------------------
: "${ENVOS_DISPLAY:=:27}"
: "${ENVOS_GEOM:=1920x1080x24}"
: "${ENVOS_VNC_PORT:=5927}"
: "${ENVOS_WEB_PORT:=8752}"

# --- ports -------------------------------------------------------------------
# mock = the stock Hub app server (the agent never sees it)
# proxy = the re-grounding proxy in front of it (the agent's only address)
: "${ENVOS_EXPEDIA_MOCK:=8301}"
: "${ENVOS_GMAIL_MOCK:=8302}"
: "${ENVOS_GCAL_MOCK:=8303}"
: "${ENVOS_EXPEDIA_PROXY:=8431}"
: "${ENVOS_GMAIL_PROXY:=8432}"
: "${ENVOS_GCAL_PROXY:=8433}"

# --- phenomenon timing -------------------------------------------------------
: "${ENVOS_DWELL_S:=12}"               # exposure: agent must have SEEN the
                                       # consistent world this long before it breaks
: "${ENVOS_FIRE_AT_S:=900}"            # fallback timer from first contact
: "${ENVOS_ACL_DELAY_S:=25}"           # XAPP_ACL stage 2: how long after the
                                       # commit the calendar goes read-only

# --- agent harness -----------------------------------------------------------
: "${ENVOS_MODEL:=opus}"
: "${ENVOS_TURNS:=120}"
: "${ENVOS_TIMEOUT:=2400}"
